DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/expense_tracker
JWT_SECRET_KEY=replace-with-a-secure-secret-key
FLASK_ENV=development
FLASK_DEBUG=1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_NAME=Expense Tracker Admin
ADMIN_URL=/admin
ADMIN_THEME_SWATCH=default
ENABLE_ADMIN=true

# Layer 1 AI provider boundary. Local development defaults to LM Studio.
AI_PROVIDER=lm_studio
AI_REQUEST_TIMEOUT_SECONDS=30
LM_STUDIO_BASE_URL=http://localhost:1234/v1
# Use a model that supports structured JSON output; LM Studio notes that some models below 7B do not.
LM_STUDIO_MODEL=replace-with-a-loaded-local-model-id
# Production may select Gemini. Keep this credential server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=
